# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Cryptographic Security Secret (used for HMAC-SHA256 signature on QR tokens)
HMAC_SECRET=campus-ticketing-super-secure-secret-key-2026

# Email Dispatcher Configuration
# Supported providers: 'ethereal' (auto-generates sandbox inbox with instant web preview),
# 'smtp' (connects to real providers like SendGrid, Brevo, Resend, Gmail, Amazon SES), or 'console'.
MAIL_PROVIDER=ethereal

# Real SMTP Provider Settings (Uncomment & fill when deploying or testing with real inbox):
# --- Example 1: Resend SMTP ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key_here
# EMAIL_FROM="Campus Events" <tickets@yourdomain.com>

# --- Example 2: Brevo (Sendinblue) ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_brevo_login@example.com
# SMTP_PASS=your_brevo_smtp_key
# EMAIL_FROM="Campus Events" <tickets@yourdomain.com>

# --- Example 3: SendGrid ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key
# EMAIL_FROM="Campus Events" <tickets@yourdomain.com>

# --- Example 4: Gmail SMTP (App Password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_app_password
# EMAIL_FROM="Campus Events" <your_email@gmail.com>

# Database Location
DB_PATH=./database.sqlite
